{
  "manifest_version": 3,
  "name": "Authenticator App Default for GitHub 2FA",
  "short_name": "GH 2FA App Default",
  "version": "1.0.0",
  "description": "Skips passkey and GitHub Mobile prompts and goes straight to authenticator app code entry on GitHub 2FA.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/sessions/two-factor*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
